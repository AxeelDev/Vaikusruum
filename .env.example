# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Public address, used for canonical links, the sitemap and share previews.
NEXT_PUBLIC_SITE_URL=https://vaikusruum.ee

# E-mail notifications for form messages (Resend). The sender must be on a domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM="Vaikusruum <teavitus@vaikusruum.ee>"
# Fallback recipient when no contact or registration e-mail is set in Seaded.
CONTACT_NOTIFICATION_EMAIL=

# Random secret strings (e.g. `openssl rand -hex 32`).
# CRON_SECRET: Vercel Cron sends it to /api/cron/daily (backup + 12-month cleanup of form messages).
CRON_SECRET=
# IP_HASH_SALT: salts the hashed visitor IP used for form rate limiting; raw IPs are never stored.
IP_HASH_SALT=
